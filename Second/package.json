{
    "name": "dental-clinic-monorepo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev:public": "cd ../Main/client && npm run dev",
        "dev:admin": "cd client && npm run dev",
        "dev:server": "cd server && npm run start:dev",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:public\" \"npm run dev:admin\" --names \"SERVER,PUBLIC,ADMIN\" --prefix-colors \"blue,green,magenta\"",
        "install:all": "cd client && npm install && cd ../server && npm install"
    },
    "devDependencies": {
        "@prisma/client": "5.22",
        "@types/node": "^25.2.1",
        "@types/react": "^19.2.14",
        "concurrently": "^8.2.2",
        "dotenv": "^17.2.4",
        "glob": "^13.0.6",
        "prisma": "5.22",
        "strip-comments": "^2.0.1",
        "ts-morph": "^27.0.2",
        "tsx": "^4.21.0"
    },
    "dependencies": {
        "nodemailer": "^8.0.2"
    }
}
